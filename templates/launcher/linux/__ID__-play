#!/bin/sh
# Plays @GAME@ on Linux through Wine and gamescope, using the
# rea-launcher-sdk play library (sdk/rea-play.sh; see its shell/README.md).
#
#   @ID@-play             show the settings window, then start the game
#   @ID@-play --play      start with the saved settings (no window)
#   @ID@-play stop        end the game session and its private Wine prefix
#   @ID@-play status      running or idle
#
# Optional environment:
#   @PREFIX@_PREFIX    Wine prefix (default ~/.local/share/@ID@-launcher/prefix)
#   @PREFIX@_LAUNCHER  @LAUNCHER_EXE@ (default: next to this script, or one up)
#   @PREFIX@_RUN       a wrapper that runs wine and gamescope, e.g.
#                      "distrobox enter gaming --" when they live in a container
#   @PREFIX@_WAIT      set by the AppImage (every launch waits anyway)
#   @PREFIX@_GPU       GPU environment to use instead of the detected one
set -u

# --- the library: next to this script in a package, else the vendored copy --
# Tests source this script with REA_FUNCTIONS_ONLY=1 (load, don't run) and
# REA_PLAY_HERE=<this script's folder> ($0 is then the test). REA_PLAY_HERE
# counts only in that mode; the library drops both once sourced.
_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=@ID@-play

# --- configuration (after sourcing: inherited REA_* values are dropped, so
# only the player-facing @PREFIX@_* names below reach the library) ----------
REA_APP=@ID@-launcher                 # ~/.config/@ID@-launcher, the prefix name
REA_EXE_NAME=@LAUNCHER_EXE@
REA_EXE_HINT=@PREFIX@_LAUNCHER
REA_EXE=${@PREFIX@_LAUNCHER:-}
REA_PREFIX=${@PREFIX@_PREFIX:-}
REA_RUN=${@PREFIX@_RUN:-}
REA_WAIT=${@PREFIX@_WAIT:-}
[ -n "${@PREFIX@_GPU+set}" ] && REA_GPU=$@PREFIX@_GPU   # @PREFIX@_GPU= for no GPU choice
REA_CFG_APPDATA=@LAUNCHER_NAME@       # AppData\Local\@LAUNCHER_NAME@\launcher.cfg
REA_WINEDBG_OFF=1                     # a fault ends the game, no hidden debugger
# Game choices to make once the game is known (sdk shell/README.md, "Game
# differences kept as settings"):
#   REA_ORIGINAL_SIZE=640x480         what resolution = original means
#   REA_DLL_OVERRIDES='d3d9=n,b'      the game's WINEDLLOVERRIDES (DXVK, ...)
#   REA_GAME_PROCS='@GAME_EXE@'       when the launcher returns before the game
#                                     (at most 15 characters per name)

# --- game hooks --------------------------------------------------------------

# Once per prefix: no crash dialog.
rea_hook_before_start() {
  rea_wine_no_crash_dialog
}

rea_init || exit 1
# Tests load the configuration and hooks without running anything.
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
