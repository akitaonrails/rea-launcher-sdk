#!/bin/sh
# rea-launcher-sdk scripts/sdk-sync: vendors the SDK's shell and packaging
# files into a launcher repository under sdk/, stamped with sdk/VERSION.
#
#   scripts/sdk-sync [--tag TAG] <launcher-repo>   write <launcher-repo>/sdk
#   scripts/sdk-sync --check <launcher-repo>       exit 1 when sdk/ drifted
#   scripts/sdk-sync --check --against-head [--tag TAG] <launcher-repo>
#
# --check compares sdk/ with the SDK version recorded in sdk/VERSION (its
# commit), whatever this SDK checkout is at: it runs that version's own
# sdk-sync from a temporary `git clone --shared` of this repository (read
# only; the commit must be in it: `git fetch --tags` if not). When VERSION
# names this checkout's clean HEAD, or an unreproducible commit ("-dirty",
# "unknown"), it compares with this work tree. --against-head always
# compares with this work tree (the old behaviour).
#
# Layout: sdk/rea-play.sh (from shell/), sdk/scripts/{wine-test,sdk-bump,clean},
# sdk/packaging/... and sdk/docs/{STANDARDS.md,playbooks/*.md} (as in the
# SDK), so a launcher refers to the SDK's wording instead of copying it.
# sdk/ belongs to this script: never edit it by hand, re-run the sync.
# VERSION records the SDK tag (git describe --exact-match, or --tag, or
# "untagged") and commit ("-dirty" when the SDK files had local changes).
set -eu
die() { echo "sdk-sync: $*" >&2; exit 1; }
usage() { echo "usage: $0 [--tag TAG] <launcher-repo> | $0 --check [--against-head [--tag TAG]] <launcher-repo>" >&2; exit 2; }

SDK=$(cd "$(dirname "$0")/.." && pwd -P)
MODE=sync TAG='' AGAINST_HEAD=''
while [ $# -gt 0 ]; do
  case $1 in
    --check) MODE=check; shift ;;
    --against-head) AGAINST_HEAD=1; shift ;;
    --tag) [ $# -ge 2 ] || usage; TAG=$2; shift 2 ;;
    -h | --help) usage ;;
    -*) die "unknown option $1" ;;
    *) break ;;
  esac
done
[ $# -eq 1 ] || usage
[ -d "$1" ] || die "no launcher repository $1"
REPO=$(cd "$1" && pwd -P)
[ "$REPO" != "$SDK" ] || die "refusing to vendor the SDK into itself"
[ -z "$AGAINST_HEAD" ] || [ "$MODE" = check ] || die "--against-head goes with --check"

# --check against the recorded version: hand over to that version's sdk-sync.
if [ "$MODE" = check ] && [ -z "$AGAINST_HEAD" ] && [ -f "$REPO/sdk/VERSION" ]; then
  rec_tag=$(sed -n 's/^tag=//p' "$REPO/sdk/VERSION")
  rec_commit=$(sed -n 's/^commit=//p' "$REPO/sdk/VERSION")
  case $rec_tag in '' | *[!A-Za-z0-9._+-]*) die "bad tag in $REPO/sdk/VERSION" ;; esac
  head=$(git -C "$SDK" rev-parse HEAD 2>/dev/null || echo none)
  case $rec_commit in
    '' | unknown | *-dirty)
      echo "sdk-sync: sdk/VERSION names no reproducible commit ($rec_commit); comparing with this work tree" >&2
      TAG=$rec_tag AGAINST_HEAD=1 ;;
    *[!0-9a-f]*) die "bad commit in $REPO/sdk/VERSION" ;;
    "$head")
      TAG=$rec_tag AGAINST_HEAD=1 ;;  # this checkout is that version
    *)
      git -C "$SDK" cat-file -e "$rec_commit^{commit}" 2>/dev/null \
        || die "SDK $rec_tag ($rec_commit) is not in $SDK: git -C $SDK fetch --tags, or pass --against-head"
      AT=$(mktemp -d "${TMPDIR:-/tmp}/sdk-sync-at.XXXXXX")
      trap 'rm -rf "$AT"' EXIT
      trap 'exit 129' HUP
      trap 'exit 130' INT
      trap 'exit 143' TERM
      git clone --quiet --shared --no-checkout "$SDK" "$AT/sdk" || die "cannot clone $SDK"
      git -C "$AT/sdk" -c advice.detachedHead=false checkout --quiet --detach "$rec_commit" \
        || die "cannot check out $rec_commit"
      [ -f "$AT/sdk/scripts/sdk-sync" ] || die "SDK $rec_tag has no scripts/sdk-sync"
      echo "sdk-sync: comparing with SDK $rec_tag ($rec_commit), the version in sdk/VERSION" >&2
      set -- --check --tag "$rec_tag"
      # Versions with --against-head compare with their own (clean) tree that way.
      if grep -q -- '--against-head' "$AT/sdk/scripts/sdk-sync"; then set -- "$@" --against-head; fi
      status=0
      sh "$AT/sdk/scripts/sdk-sync" "$@" "$REPO" || status=$?
      exit "$status" ;;
  esac
fi

# The vendored set, SDK-relative (dest() maps it into sdk/).
files() {
  (
    cd "$SDK"
    for f in shell/rea-play.sh scripts/wine-test scripts/sdk-bump scripts/clean scripts/prepush-scan packaging/*.sh packaging/appimage/AppRun.in \
      packaging/appimage/tools.pins packaging/appimage/wine/COPYING.LIB \
      packaging/appimage/wine/LICENSE packaging/appimage/wine/SOURCE.txt \
      docs/STANDARDS.md docs/playbooks/*.md; do
      if [ -f "$f" ]; then printf '%s\n' "$f"; fi
    done
  )
}

# Stamp: tag and commit of the SDK checkout.
if [ -z "$TAG" ]; then
  TAG=$(git -C "$SDK" describe --tags --exact-match HEAD 2>/dev/null || echo untagged)
fi
case $TAG in *[!A-Za-z0-9._+-]*) die "unsafe tag '$TAG'" ;; esac
COMMIT=$(git -C "$SDK" rev-parse HEAD 2>/dev/null || echo unknown)
# shellcheck disable=SC2046
if [ "$COMMIT" != unknown ] && [ -n "$(git -C "$SDK" status --porcelain -- $(files) 2>/dev/null)" ]; then
  COMMIT=$COMMIT-dirty
fi

T=$(mktemp -d "${TMPDIR:-/tmp}/sdk-sync.XXXXXX")
trap 'rm -rf "$T"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

STAGE=$T/sdk
mkdir -p "$STAGE"
files > "$T/list"
[ -s "$T/list" ] || die "no SDK files found in $SDK"
# The play library sits at sdk/rea-play.sh, where the helpers look for it.
dest() { case $1 in shell/rea-play.sh) echo rea-play.sh ;; *) echo "$1" ;; esac; }
while IFS= read -r f; do
  d=$(dest "$f")
  mkdir -p "$STAGE/$(dirname "$d")"
  cp "$SDK/$f" "$STAGE/$d"
  if [ -x "$SDK/$f" ]; then chmod 755 "$STAGE/$d"; else chmod 644 "$STAGE/$d"; fi
done < "$T/list"
{
  echo "# Vendored by rea-launcher-sdk scripts/sdk-sync; do not edit sdk/ by hand."
  echo "tag=$TAG"
  echo "commit=$COMMIT"
} > "$STAGE/VERSION"

# A sync interrupted mid-swap leaves .sdk-sync.old.<pid> (the previous
# sdk/) and maybe a partial .sdk-sync.new.<pid>.
interrupted() {
  for d in "$REPO"/.sdk-sync.old.*; do
    if [ -f "$d/VERSION" ]; then printf '%s\n' "$d"; return 0; fi
  done
  return 1
}

if [ "$MODE" = check ]; then
  if [ ! -d "$REPO/sdk" ] && interrupted >/dev/null; then
    die "$REPO/sdk is missing after an interrupted sync; re-run scripts/sdk-sync $REPO"
  fi
  [ -d "$REPO/sdk" ] || die "$REPO has no sdk/ (run scripts/sdk-sync $REPO)"
  (cd "$STAGE" && find . -type f | LC_ALL=C sort) > "$T/want"
  (cd "$REPO/sdk" && find . ! -type d | LC_ALL=C sort) > "$T/have"
  LC_ALL=C comm -23 "$T/want" "$T/have" | sed 's|^\./|  missing: sdk/|' > "$T/report"
  LC_ALL=C comm -13 "$T/want" "$T/have" | sed 's|^\./|  not from the SDK: sdk/|' >> "$T/report"
  LC_ALL=C comm -12 "$T/want" "$T/have" > "$T/both"
  while IFS= read -r f; do
    f=${f#./}
    if [ -L "$REPO/sdk/$f" ] || ! cmp -s "$STAGE/$f" "$REPO/sdk/$f"; then
      echo "  changed: sdk/$f" >> "$T/report"
    else
      want_x=0 have_x=0
      if [ -x "$STAGE/$f" ]; then want_x=1; fi
      if [ -x "$REPO/sdk/$f" ]; then have_x=1; fi
      [ "$want_x" = "$have_x" ] || echo "  mode differs: sdk/$f" >> "$T/report"
    fi
  done < "$T/both"
  if [ -s "$T/report" ]; then
    echo "sdk-sync: $REPO/sdk differs from rea-launcher-sdk $TAG ($COMMIT):" >&2
    cat "$T/report" >&2
    echo "sdk-sync: re-run scripts/sdk-sync from the SDK version the launcher should use" >&2
    exit 1
  fi
  echo "sdk/ matches rea-launcher-sdk $TAG ($COMMIT)"
  exit 0
fi

# Recover from an interrupted swap: restore the previous sdk/, then drop
# leftovers from earlier runs.
if [ ! -e "$REPO/sdk" ] && old=$(interrupted); then
  mv "$old" "$REPO/sdk"
  echo "sdk-sync: restored $REPO/sdk from an interrupted sync" >&2
fi
for d in "$REPO"/.sdk-sync.new.* "$REPO"/.sdk-sync.old.*; do
  if [ -e "$d" ]; then rm -rf "$d"; fi
done

# Sync: replace sdk/ as a whole, but never a folder this script didn't write.
if [ -e "$REPO/sdk" ] && [ ! -f "$REPO/sdk/VERSION" ]; then
  die "$REPO/sdk exists without sdk/VERSION; move it away first"
fi
NEW=$REPO/.sdk-sync.new.$$ OLD=$REPO/.sdk-sync.old.$$
rm -rf "$NEW" "$OLD"
cp -R "$STAGE" "$NEW"
if [ -e "$REPO/sdk" ]; then mv "$REPO/sdk" "$OLD"; fi
mv "$NEW" "$REPO/sdk"
rm -rf "$OLD"
echo "vendored rea-launcher-sdk $TAG ($COMMIT) into $REPO/sdk"
